# Copiez vers .env puis remplacez les valeurs d'exemple.
APP_ENV=development
POSTGRES_DB=projet_rh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optionnel : si DATABASE_URL est renseigné, il devient la source unique pour SQLAlchemy et psycopg2.
# DATABASE_URL=postgresql://postgres:mot_de_passe@localhost:5432/projet_rh

# Générez une clé différente et aléatoire pour chaque environnement.
# Exemple PowerShell : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_TOKEN_LIFETIME_HOURS=1

# Origines autorisées pour les appels directs au backend (le proxy Angular évite CORS en développement).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
MAX_CONTENT_LENGTH_MB=10
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
