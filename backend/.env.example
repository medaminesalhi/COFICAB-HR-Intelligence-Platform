# Copiez ce fichier vers .env puis adaptez les valeurs à votre environnement local.
POSTGRES_DB=projet_rh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optionnel : DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/projet_rh
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_TOKEN_LIFETIME_HOURS=1
FLASK_DEBUG=false
